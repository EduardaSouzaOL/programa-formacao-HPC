# NOTE: this definition file depends on features only available in
# Singularity 3.2 and later.
BootStrap: docker
From: ubuntu:22.04
Stage: build
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libboost-dev \
        libeigen3-dev \
        zlib1g-dev
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    mkdir -p /src
    cd /src
    git clone --recursive https://github.com/iqtree/iqtree2.git .
    git checkout a00094e0
    git submodule update --init --recursive
    mkdir build
    cd build
    cmake -DCMAKE_BUILD_TYPE=Release ..
    make -j2

# NOTE: this definition file depends on features only available in
# Singularity 3.2 and later.
BootStrap: docker
From: ubuntu:22.04
Stage: final
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libgomp1 \
        zlib1g
    rm -rf /var/lib/apt/lists/*

%files from build
    /src/build/iqtree2 /usr/local/bin/iqtree2

%post
    cd /
    mkdir -p /data
    cd /data

%runscript
    exec iqtree2 "$@"
